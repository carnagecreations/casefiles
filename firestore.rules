rules_version = '2';

// Any signed-in team member (an account added by hand in the Firebase
// console) has full read/write access to every document. There is no
// self-service signup, so "signed in" already means "someone on the
// Clean Convictions team."
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
